# Django Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Django Secret Key
# Generate a new secret key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your_secret_key_here

# GitHub Configuration
# GitHub username for API access
GHUSER=your_github_username

# GitHub Personal Access Token with 'repo' and 'workflow' scopes
# Create at: https://github.com/settings/tokens
GHBEARER=your_github_token_here

# Generator URL - URL where this Django application is running
GENURL=http://your_server_ip:9000

# Protocol to use (http or https)
PROTOCOL=http

# Repository name (usually 'rustgen' for RustDesk generator)
REPONAME=rustgen

# Django Debug Mode
# Set to True for development, False for production
DEBUG=True

# Additional Configuration Options (uncomment and configure as needed)

# CSRF Trusted Origins (for production)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration (for PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Redis/Cache Configuration
# REDIS_URL=redis://localhost:6379/0

# Celery Configuration (for background tasks)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
